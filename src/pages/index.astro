---
import HeroArtwork from "../components/HeroArtwork";
import Reveal from "../components/Reveal";
import Entrance from "../components/Entrance";
import TextReveal from "../components/TextReveal";
import "../styles/brand.css";
import "../styles/home.css";

const features = [
  { number: "01", title: "A home for every class.", text: "Bring announcements, materials, and assignments together, with spaces for students and instructors.", icon: "▦", label: "Classes & classwork" },
  { number: "02", title: "Your notes, close by.", text: "Keep class materials organized. Download files in the app so you can open them again without a connection.", icon: "↓", label: "Files & offline access" },
  { number: "03", title: "Make room for questions.", text: "Explore your materials with AI-assisted study tools, from notebook conversations to flashcards and practice quizzes.", icon: "✳", label: "AI-assisted study" },
];
const team = [
  { name: "Christian Orlan Motas", role: "System Analyst", photo: "", description: "Connecting project requirements, system structure, and the way Filo works." },
  { name: "Rogelyn Nepa", role: "Project Manager", photo: "", description: "Bringing the team's plans, priorities, and project milestones together." },
  { name: "Kent Aian Tabuelog", role: "Frontend Developer", photo: "", description: "Shaping the screens and interactions that bring Filo's learning space to life." },
  { name: "Rose Jean Tupaz", role: "Backend Developer", photo: "", description: "Working on the data and services that connect Filo behind the scenes." },
  { name: "Jhondel Cabugsa", role: "Quality Assurance", photo: "", description: "Checking the details, exploring user flows, and helping the team find what needs care." },
  { name: "Zaira Jane Estrada", role: "Technical Writer", photo: "", description: "Turning the project's ideas and technical details into clear, useful documentation." },
];
const questions = [
  { question: "What is Filo?", answer: "Filo is an Android learning management app for students and instructors. It brings class materials, assignments, assessments, and AI-assisted study into one place. This website introduces the project." },
  { question: "Can I download the app now?", answer: "Yes! You can download the preview APK directly using the download button on this page. Release notes and updates are also available on our GitHub repository." },
  { question: "What can I use offline?", answer: "Downloaded files and saved study sets are intended for offline access in the app. Signing in, syncing, generating AI content, submitting work, and taking official quizzes or exams require an internet connection." },
  { question: "Can I use Filo in my browser?", answer: "Filo is being developed for Android. This is its public information website; classes and study tools are accessed in the app." },
  { question: "Does AI replace my instructor?", answer: "No. AI is a study aid and can make mistakes. Check answers against your source materials and ask your instructor when something needs clarification." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Meet Filo, an Android learning app bringing classes, materials, and AI-assisted study closer together. Discover the project and the idea behind it." />
    <meta name="theme-color" content="#f9faf5" />
    <script is:inline>
      try {
        if (localStorage.getItem("filo:theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>
    <meta property="og:title" content="Filo — Learning, together." />
    <meta property="og:description" content="Your classes, your notes, your next discovery. Meet the Android learning app being built to bring them together." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/assets/brand/logo-mark-light.png" />
    <link rel="preload" href="/assets/fonts/Nunito.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/assets/mascots/entry/waving.png" as="image" type="image/png" />
    <link rel="preload" href="/assets/mascots/entry/cheerful.png" as="image" type="image/png" />
    <link rel="preload" href="/assets/mascots/entry/curious.png" as="image" type="image/png" />
    <title>Filo — Learning, together.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="#" aria-label="Filo home"><img class="brand-mark-light" src="/assets/brand/logo-mark-light.png" width="36" height="36" alt="" /><img class="brand-mark-dark" src="/assets/brand/logo-mark-dark.png" width="36" height="36" alt="" /><span>filo</span></a>
        <nav aria-label="Main navigation">
          <a href="#features">Discover Filo</a>
          <a href="#about">About us</a>
          <a href="#team">Our team</a>
          <a href="#faq">FAQ</a>
        </nav>
        <div class="header-actions">
          <button id="theme-toggle" class="theme-toggle" type="button" role="switch" aria-label="Dark mode" aria-checked="false" title="Switch to dark mode" hidden>
            <span class="theme-thumb" aria-hidden="true"></span>
            <svg class="theme-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
            <svg class="theme-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13.1A8.5 8.5 0 0 1 10.9 3.5a8.5 8.5 0 1 0 9.6 9.6Z" /></svg>
          </button>
          <details class="download-dropdown header-download-dropdown">
            <summary class="button button-small header-cta">
              <svg class="download-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
              <span>Download APK</span>
              <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="download-menu header-download-menu">
              <div class="download-menu-header">Choose APK build</div>
              <a class="download-option" href="/releases/Filo-v0.1.0-preview.1-arm64.apk" download="Filo-v0.1.0-preview.1-arm64.apk">
                <div class="option-text">
                  <div class="option-title-row">
                    <span class="option-title">New build (ARM64)</span>
                  </div>
                  <span class="option-desc">Modern Android 8.0+ devices · 64-bit</span>
                </div>
                <span class="option-size">68 MB <span aria-hidden="true">↓</span></span>
              </a>
              <a class="download-option" href="/releases/Filo-v0.1.0-preview.1-armv7.apk" download="Filo-v0.1.0-preview.1-armv7.apk">
                <div class="option-text">
                  <div class="option-title-row">
                    <span class="option-title">Old build (ARMv7)</span>
                  </div>
                  <span class="option-desc">Older Android devices · 32-bit</span>
                </div>
                <span class="option-size">60 MB <span aria-hidden="true">↓</span></span>
              </a>
              <a class="download-option" href="/releases/Filo-v0.1.0-preview.1-x86_64.apk" download="Filo-v0.1.0-preview.1-x86_64.apk">
                <div class="option-text">
                  <div class="option-title-row">
                    <span class="option-title">Emulator build (x86_64)</span>
                  </div>
                  <span class="option-desc">PC, tablets & Android emulators</span>
                </div>
                <span class="option-size">70 MB <span aria-hidden="true">↓</span></span>
              </a>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <Entrance client:load>
      <section class="hero wrap" aria-labelledby="hero-title">
        <Reveal className="hero-copy" client:load>
          <p class="eyebrow"><span class="little-leaf" aria-hidden="true"></span>A little space. A lot of possibility.</p>
          <h1 id="hero-title">Learning,<br /><span class="highlight">together.</span></h1>
          <p class="hero-description">Your classes. Your notes. Your next discovery.<br class="desktop-break" /> A calmer place to bring it all together.</p>
          <div class="hero-actions">
            <a class="button" href="#features">Take a look around <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#about">The story behind Filo <span aria-hidden="true">→</span></a>
          </div>
          <p class="availability-note"><span aria-hidden="true">◌</span> Made for Android · Preview APK available</p>
        </Reveal>
        <HeroArtwork client:load />
      </section>
      </Entrance>

      <div class="intro-strip">
        <div class="wrap strip-inner"><p>Less scattered.<br /><strong>More connected.</strong></p><span>Classes with a place.</span><span>Notes within reach.</span><span>Curiosity welcome.</span></div>
      </div>

      <section class="section wrap" id="features" aria-labelledby="features-title">
        <Reveal className="section-heading" client:load><div><p class="eyebrow">A place for the everyday</p><TextReveal id="features-title" lines={["All the little things.", "A little closer together."]} client:visible /></div><p>From the first class announcement to the question you ask after class, Filo is being built around the way learning happens.</p></Reveal>
        <div class="feature-grid">
          {features.map((feature, index) => <Reveal className="feature-reveal" delay={index * 0.1} client:load><article class:list={["feature", `feature-${feature.number}`]}><div class="feature-top"><span class="feature-icon" aria-hidden="true">{feature.icon}</span><span class="feature-number" aria-hidden="true">{feature.number}</span></div><p class="feature-label">{feature.label}</p><TextReveal as="h3" lines={[feature.title]} client:visible /><p>{feature.text}</p></article></Reveal>)}
        </div>
        <p class="feature-footnote">A look at Filo’s direction. Feature availability and release details will be shared with the app.</p>
      </section>

      <section class="study-section" aria-labelledby="study-title">
        <div class="wrap study-layout">
          <Reveal className="study-illustration" client:load><img src="/assets/mascots/reading.png" alt="" width="720" height="720" loading="lazy" decoding="async" /><span class="study-sticker">Stay curious. <span aria-hidden="true">✧</span></span></Reveal>
          <Reveal className="study-copy" delay={0.1} client:load><p class="eyebrow">Small steps. New discoveries.</p><TextReveal id="study-title" lines={["Meet your next", "“Oh, I get it.”"]} client:visible /><p class="section-copy">A question about your notes. A flashcard on the way home. Another chance to practice. Make a little room for understanding, at your own pace.</p><ul class="study-list"><li><span aria-hidden="true">↗</span> Explore questions around your materials</li><li><span aria-hidden="true">↗</span> Review with flashcards and practice quizzes</li><li><span aria-hidden="true">↗</span> Keep saved study sets close, even offline</li></ul><p class="quiet-note">AI can make mistakes. Your materials and instructor remain your guides.</p></Reveal>
        </div>
      </section>

      <section class="section wrap about-layout" id="about" aria-labelledby="about-title">
        <Reveal client:load><p class="eyebrow">The people & the purpose</p><TextReveal id="about-title" lines={["Built around", "a familiar feeling."]} client:visible /><p class="about-signature">Too many tabs.<br />One more missing file.<br /><strong>There had to be a calmer way.</strong></p></Reveal>
        <Reveal className="about-story" delay={0.1} client:load><p class="lead">Learning is already a lot.<br />Finding everything shouldn’t be.</p><p>Filo began as a final-year school project with a simple idea: bring class materials, activities, and study support into one place.</p><p>It is being built for students keeping up with class and instructors helping them move forward. The goal is a learning space that feels organized, approachable, and a little more human.</p><a class="text-link" href="#team">Meet the people behind Filo <span aria-hidden="true">↗</span></a></Reveal>
      </section>

      <section class="team-section" id="team" aria-labelledby="team-title"><div class="wrap">
        <Reveal className="section-heading" client:load><div><p class="eyebrow">Six people. One shared idea.</p><TextReveal id="team-title" lines={["The people", "behind Filo."]} client:visible /></div><p>Different roles, a shared purpose: making learning feel a little more connected. Get to know the team bringing Filo together.</p></Reveal>
        <div class="team-grid">{team.map((member, index) => <Reveal className="team-reveal" delay={(index % 2) * 0.1} client:load>
          <article class="team-profile" data-tone={index % 3}>
            <div class="team-portrait">
              <span class="portrait-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              {member.photo ? <img src={member.photo} alt={`Portrait of ${member.name}`} width="640" height="800" loading="lazy" decoding="async" /> : <><div class="portrait-silhouette" aria-hidden="true"><span class="portrait-head"></span><span class="portrait-shoulders"></span></div><span class="portrait-pending">Portrait coming soon</span></>}
            </div>
            <div class="team-caption"><p class="team-role">{member.role}</p><TextReveal as="h3" lines={[member.name]} client:visible /><p class="team-description">{member.description}</p></div>
          </article>
        </Reveal>)}</div>
      </div></section>

      <section class="faq-section" id="faq" aria-labelledby="faq-title"><div class="wrap faq-layout"><Reveal client:load><p class="eyebrow">Good questions</p><TextReveal id="faq-title" lines={["A little more", "about Filo."]} client:visible /><p class="section-copy">Before your next discovery,<br />a few things worth knowing.</p></Reveal><Reveal className="faq-list" delay={0.1} client:load>{questions.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</Reveal></div></section>

      <section class="section wrap" id="availability" aria-labelledby="availability-title">
        <Reveal className="closing-panel" client:load>
          <span class="closing-spark" aria-hidden="true">✳</span>
          <p class="eyebrow">Explore the project</p>
          <TextReveal id="availability-title" lines={["A new little home", "for your learning."]} client:visible />
          <p>Explore the project, browse source code,<br />and follow release updates on GitHub.</p>
          <div class="release-actions">
            <a class="button release-github-link" href="https://github.com/rogiie234/filo-app" target="_blank" rel="noopener noreferrer"><svg class="github-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" /></svg><span>Explore on GitHub</span><span class="external-arrow" aria-hidden="true">↗</span></a>
          </div>
          <p class="quiet-note release-note">Filo v0.1.0-preview.1 · Open-source Android learning app</p>
        </Reveal>
      </section>
    </main>

    <footer class="site-footer wrap"><div><a class="brand" href="#" aria-label="Filo home"><img class="brand-mark-light" src="/assets/brand/logo-mark-light.png" width="36" height="36" alt="" /><img class="brand-mark-dark" src="/assets/brand/logo-mark-dark.png" width="36" height="36" alt="" /><span>filo</span></a><p>A little more room to learn.</p></div><nav aria-label="Footer navigation"><a href="#features">Discover</a><a href="#about">About us</a><a href="#team">Our team</a><a href="#faq">FAQ</a></nav><p class="footer-note">Learning, together.<br />An Android learning app project.</p></footer>
    <script>
      import { applyTheme } from "../scripts/theme";
      const toggle = document.getElementById("theme-toggle");
      if (toggle) {
        applyTheme(document.documentElement.dataset.theme === "dark" ? "dark" : "light");
        toggle.hidden = false;
        toggle.addEventListener("click", () => {
          applyTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark");
        });
      }

      document.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        document.querySelectorAll("details.download-dropdown[open]").forEach((details) => {
          if (!details.contains(target) || target.closest(".download-option")) {
            details.removeAttribute("open");
          }
        });
      });
    </script>
  </body>
</html>
